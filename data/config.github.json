{
  "ai": {
    "provider": "deepseek",
    "model": "deepseek-chat",
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "temperature": 0.2,
    "max_tokens": 8192,
    "throttle_sec": 0.5,
    "languages": [
      "zh"
    ],
    "analysis_concurrency": 3,
    "enrichment_concurrency": 2
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "tech-blog",
    "profile_settings": {
      "tech-news": {
        "threshold": 7.5,
        "topic_dedup": true
      },
      "tech-blog": {
        "threshold": 7.5,
        "topic_dedup": true
      }
    }
  },
  "sources": {
    "ossinsight": {
      "enabled": true,
      "period": "past_24_hours",
      "languages": ["All", "Python", "TypeScript", "Rust"],
      "keywords": ["llm", "agent", "mcp", "rag", "inference", "vllm", "eval", "context", "memory", "cuda"],
      "min_stars": 20,
      "max_items": 20,
      "category": "oss-trending",
      "profile": "tech-news"
    },
    "github": [
      {
        "type": "user_events",
        "username": "karpathy",
        "enabled": true,
        "category": "ai-core",
        "profile": "tech-news"
      },
      {
        "type": "repo_releases",
        "owner": "vllm-project",
        "repo": "vllm",
        "enabled": true,
        "category": "ai-infra",
        "profile": "tech-news"
      },
      {
        "type": "repo_releases",
        "owner": "sgl-project",
        "repo": "sglang",
        "enabled": true,
        "category": "ai-infra",
        "profile": "tech-news"
      },
      {
        "type": "repo_releases",
        "owner": "anthropics",
        "repo": "claude-code",
        "enabled": true,
        "category": "ai-agent",
        "profile": "tech-news"
      }
    ],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 30,
      "min_score": 120,
      "category": "hn-discussion",
      "profile": "tech-blog"
    },
    "rss": [
      {
        "name": "Simon Willison (AI Engineering)",
        "url": "https://simonwillison.net/atom/everything/",
        "enabled": true,
        "category": "ai-engineering",
        "profile": "tech-blog",
        "content_extractor": "trafilatura"
      },
      {
        "name": "Lilian Weng (OpenAI Research)",
        "url": "https://lilianweng.github.io/index.xml",
        "enabled": true,
        "category": "ai-research",
        "profile": "tech-blog",
        "content_extractor": "trafilatura"
      },
      {
        "name": "Hugging Face Blog",
        "url": "https://huggingface.co/blog/feed.xml",
        "enabled": true,
        "category": "ai-research",
        "profile": "tech-blog",
        "content_extractor": "trafilatura"
      },
      {
        "name": "vLLM Blog",
        "url": "https://vllm.ai/blog/rss.xml",
        "enabled": true,
        "category": "ai-infra",
        "profile": "tech-blog",
        "content_extractor": "trafilatura"
      },
      {
        "name": "Latent Space (AI Engineer)",
        "url": "https://www.latent.space/feed",
        "enabled": true,
        "category": "ai-engineering",
        "profile": "tech-blog",
        "content_extractor": "trafilatura"
      },
      {
        "name": "arXiv cs.AI & cs.CL",
        "url": "https://rss.arxiv.org/rss/cs.AI+cs.CL",
        "enabled": true,
        "category": "ai-paper",
        "profile": "tech-blog"
      }
    ],
    "reddit": {
      "enabled": true,
      "subreddits": [
        {
          "subreddit": "LocalLLaMA",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 12,
          "min_score": 80,
          "category": "ai-community",
          "profile": "tech-news"
        },
        {
          "subreddit": "MachineLearning",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 80,
          "category": "ai-research",
          "profile": "tech-news"
        }
      ],
      "users": [],
      "fetch_comments": 10
    },
    "telegram": {
      "enabled": false,
      "channels": []
    }
  },
  "collection": {
    "time_window_hours": 24
  },
  "digest": {
    "max_items": 10,
    "profile_order": [
      "tech-blog",
      "tech-news"
    ],
    "category_groups": {
      "engineering_and_blog": {
        "name": "工程实践与深度技术长文",
        "limit": 4,
        "categories": ["ai-engineering", "hn-discussion", "ai-infra"]
      },
      "opensource": {
        "name": "GitHub 24h 飙升与核心发版",
        "limit": 3,
        "categories": ["oss-trending", "ai-core", "ai-agent"]
      },
      "research": {
        "name": "前沿论文与开源社区突破",
        "limit": 3,
        "categories": ["ai-research", "ai-paper", "ai-community"]
      }
    },
    "default_group": "other",
    "default_group_limit": 2
  },
  "webhook": {
    "enabled": true,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary",
    "platform": "feishu",
    "layout": "collapsible",
    "fallback_layout": "markdown",
    "languages": [
      "zh"
    ]
  }
}
